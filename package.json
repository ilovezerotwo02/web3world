{
  "name": "web3world",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-vinext.mjs dev",
    "build": "node scripts/run-vinext.mjs build",
    "start": "node scripts/start-web3world.mjs",
    "test": "npm run build && tsx --test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "contract:compile": "node scripts/compile-badge.mjs && node scripts/compile-labs.mjs",
    "security:verify": "tsx scripts/verify-security-flow.ts",
    "contract:deploy:testnet": "node scripts/deploy-badge.mjs"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "drizzle-orm": "0.45.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "better-sqlite3": "^13.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.0",
    "react-server-dom-webpack": "^19.2.8",
    "solc": "^0.8.28",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "wrangler": "^4.118.0"
  },
  "type": "module"
}
